# Azure Cognitive Services Credentials
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=centralindia
AZURE_TRANSLATOR_KEY=your_translator_key_here
AZURE_TRANSLATOR_REGION=centralindia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Server port
PORT=3001

# TTS concurrency (parallel requests to Cloud TTS API, default 8 is safe for free tier)
TTS_CONCURRENCY=8

# Max tempo speed-up ratio before accepting overrun (1.35 = 35% faster max)
STITCHER_MAX_TEMPO=1.35
