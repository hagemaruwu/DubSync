{
  "manifest_version": 3,
  "name": "DubSync – YouTube Hindi Dubbing Extension",
  "version": "1.0.0",
  "description": "Dubs YouTube videos into Hindi using Azure AI translation, Speech synthesis and drift correction",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DubSync"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
